 "cleaning_rules": {
  "Google Project Sunroof/project-sunroof-state-09082017.csv": [
   "51 real regions + 1 fully-NaN row (region_name/state_name NaN) -> dropna(subset=['state_name'])",
   "state_name is full name ('District of Columbia' included) -> direct join key with electricity-price stateDescription",
   "kw_total sum over states = 8.32e8 kW; median state kw_median = 9.75 kW/building",
   "fields kept: kw_total, kw_median, count_qualified, yearly_sunlight_kwh_median, percent_qualified, carbon_offset_metric_tons, existing_installs_count"
  ],
  "Google Project Sunroof/project-sunroof-county|city|postal_code": [
   "region_name NaN in 1-2 rows -> dropna",
   "county: 910 rows (700 unique regions), city: 7930 rows (6544 regions), postal: 10621 rows",
   "kw_total sums are mutually comparable: state 832.5M, county 819.5M, city 819.1M, postal 829.8M kW"
  ],
  "Steel_industry_data.csv": [
   "date parsed with format='%d/%m/%Y %H:%M' (day-first!) -> 2018-01-01 00:00 .. 2018-12-31 23:45, 35040 rows = 15-min grid, no gaps",
   "Load_Type distribution (2018): Light_Load 18072 (51.58%), Medium_Load 9696 (27.67%), Maximum_Load 7272 (20.75%)",
   "Usage_kWh: min 0, median 4.57, mean 27.39, max 157.18"
  ],
  "U.S._Electricity_Prices.csv": [
   "stateDescription contains 51 states + DC plus 10 census divisions (New England, Middle Atlantic, ...) and 'U.S. Total' -> must whitelist the 51 state names",
   "2017 residential: filter year==2017 & sectorName=='residential', mean of 12 monthly prices (cents/kWh); 744 monthly observations per sector in 2017",
   "state mean 2017 residential price range: see derived table (min WV/WA ~9.7, max HI ~29.5)"
  ],
  "US_Energy_Generation_2001-2022.csv": [
   "data is MONTHLY per state/source -> annual totals require sum over month",
   "keep TYPE OF PRODUCER == 'Total Electric Power Industry' to avoid double counting CHP sub-categories",
   "drop STATE == 'US-TOTAL' (national aggregate)",
   "ENERGY SOURCE 'Total' == sum of components (max deviation 7.7e-5 %), so 'Total' can be used as denominator",
   "fossil = Coal + Petroleum + Natural Gas + Other Gases; renewable = Hydroelectric Conventional + Wind + Solar Thermal and Photovoltaic + Wood and Wood Derived Fuels + Other Biomass + Geothermal; Pumped Storage and 'Other' excluded"
  ],
  "global-data-on-sustainable-energy.csv": [
   "Year 2000-2020, 176 entities; renewable-share column name: 'Renewable energy share in the total final energy consumption (%)'",
