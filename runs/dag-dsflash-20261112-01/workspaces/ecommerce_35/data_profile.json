  "method_notes": {
    "join_path": "order_items -> products (category filter) -> orders (status=delivered, non-null delivered & estimated dates) -> customers (customer_state) -> sellers (seller_state) -> reviews (latest review per order) -> geolocation zip centroids",
    "delivery_delay_days": "(order_delivered_customer_date - order_estimated_delivery_date).dt.days (negative = delivered earlier than estimated)",
    "purchase_month": "YYYY-MM of order_purchase_timestamp",
    "aggregation_grain": "seller_state x customer_state x purchase_month; avg_delivery_delay/avg_review/total_orders computed on de-duplicated order level rows, avg_freight/avg_haversine on order-item rows",
    "total_orders": "distinct order_id count within each group",
    "haversine": "Haversine with R=6371 km between seller zip centroid and customer zip centroid; missing coordinates -> NaN (9 monthly groups)",
    "arima": "statsmodels ARIMA(1,1,1) on monthly avg_delivery_delay series per state pair (>=6 monthly points); forecast_mean = mean of 12-step forecast, forecast_std = population std of the 12 forecasted values; 121/121 fits succeeded so no fallback was used",
    "known_gaps": "avg_review_score NaN in 4 monthly groups (orders without review); avg_haversine NaN in 9 monthly groups (zip prefix absent from geolocation)"
  }
