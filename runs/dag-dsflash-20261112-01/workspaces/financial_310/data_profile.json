    "reference_sql": "SELECT d.industry_name, f.period_date, SUM(f.net_profit) np, SUM(f.revenue) rev, SUM(f.net_profit)*100.0/SUM(f.revenue) margin_pct FROM fact_income_statement f JOIN dim_company d USING(company_id) WHERE f.report_type='合并报表' AND f.period_type='H1' AND f.period_date IN ('2024-06-30','2025-06-30') GROUP BY 1,2;"
