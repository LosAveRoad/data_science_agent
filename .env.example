# Pi Agent Runtime / 模型提供方（本地实验用，不进入 CI）
#
# A. DeepSeek 官方直连（按 token 计费）
#    PI_API_KEY=<deepseek key>
#    PI_BASE_URL=https://api.deepseek.com
#    MODEL_ID=deepseek-flash
#
# B. 本地代理 mistral-gateway（额度走 Mistral Vibe 订阅，模型同为 DeepSeek V4.1 Flash-1017）
#    gateway 监听 127.0.0.1:8788，客户端 API key 可填任意占位值（未设 GATEWAY_KEY 时）
#    PI_API_KEY=local-gateway
#    PI_BASE_URL=http://127.0.0.1:8788/v1
#    MODEL_ID=deepseek-v4-1-flash
PI_API_KEY=
PI_BASE_URL=
MODEL_ID=

# AgenticDataBench 数据与官方评测（本地运行用，不进入 CI）
AGENTIC_DATA_BENCH_DATA_DIR=
